# Comma-separated admin login emails allowed to trigger admin push/reconciliation endpoints.
# Must match the Firebase Auth email you use to log into the admin dashboard.
ADMIN_PUSH_EMAILS=admin@mft.com,hr@mft.com

# Optional override; defaults to projectId in src/lib/firebase-config.ts
# FIREBASE_PROJECT_ID=monkeys-have-fallen-tree

# ── Web Push (VAPID) — MUST match mft-monkeys-main ───────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@mft.com

# ── Server-Side Shift Reconciliation Cron (/api/cron/reconcile-shifts) ───────
# Secret used by Vercel Cron (`Authorization: Bearer <CRON_SECRET>`) or external
# 1–5 minute schedulers (e.g., cron-job.org / GitHub Actions on Vercel Hobby plans).
CRON_SECRET=replace-with-a-strong-random-secret

# Server Firestore credentials (configure ONE of the two options below):
# Option A (Recommended): Firebase Service Account JSON (single line) or Email + Private Key
# FIREBASE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@monkeys-have-fallen-tree.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Dedicated HR/Super Admin Firebase Auth account credentials for cron sign-in
# CRON_ADMIN_EMAIL=hr@mft.com
# CRON_ADMIN_PASSWORD=your-admin-password
