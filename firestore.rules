// Firestore security rules — MFT admin dashboard + worker portal (shared Firebase project)
// -----------------------------------------------------------------------------------------
// Deploy:   cd mft-admin && npx firebase-tools deploy --only firestore:rules
//
// Role-Based Admin Accounts:
//   1. Super Admin ("admin@mft.com" or custom claim {"admin": true} / {"role": "super_admin"})
//      → Full access to all tabs & collections.
//   2. Work & Clients Admin ("mayamahmoud@mft.com" or custom claim {"role": "ops_admin"})
//      → Access to Projects, Tasks, Submissions, Chat Notifications & Strapi CMS.
//   3. People & HR Admin ("hr@mft.com" or custom claim {"role": "hr_admin"})
//      → Access to Workers, Work Sessions, HR Dashboard, Exceptions, Reimbursements, Policy Lab & Reports.
//
// Design notes
//   - Workers may only touch their own documents.
//   - permissionLedger: workers record their own choice for TODAY only; HR-touched entries are
//     locked. Payroll (mft-admin/src/lib/admin/hrReports.ts) re-verifies minutes & quota from
//     attendance, so the ledger only needs to be trusted for the worker's choice.
//   - Attendance (workSessions) is still written by the worker's browser. A fully tamper-proof
//     clock would need a Cloud Function; these rules only stop workers editing OTHER workers' data.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Super Admin: full access to everything (Overview, Activity Log, Work & Clients, People & HR).
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') == 'super_admin'
        || request.auth.token.get('email', '') in [
          "admin@mft.com"
        ]
      );
    }

    // Work & Clients Admin: Projects, Tasks, Submissions, Chat Notifications.
    function isOpsAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          request.auth.token.get('role', '') == 'ops_admin'
          || request.auth.token.get('email', '') in [
            "mayamahmoud@mft.com"
          ]
        )
      );
    }

    // People & HR Admin: Workers, Work Sessions, HR Dashboard, Exceptions, Reimbursements, Policy Lab, Reports.
    function isHrAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          request.auth.token.get('role', '') == 'hr_admin'
          || request.auth.token.get('email', '') in [
            "hr@mft.com"
          ]
        )
      );
    }

    // Any of the 3 admin accounts.
    function isAdmin() {
      return isOpsAdmin() || isHrAdmin();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.workerId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.workerId == request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // UTC midnight of a "YYYY-MM-DD" string.
    function dayStart(ymd) {
      let p = ymd.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    // True while it is still that calendar day in Egypt (UTC+2/+3), with a small margin:
    // from 6h before to 30h after UTC midnight of `ymd`.
    function isCurrentDay(ymd) {
      return ymd is string
        && ymd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= dayStart(ymd) - duration.value(6, 'h')
        && request.time < dayStart(ymd) + duration.value(30, 'h');
    }

    // ── Workers (People & HR) ───────────────────────────────────────────────
    // Fields only HR may set (pay, tenure & leave adjustments).
    function hrOnlyWorkerFields() {
      return ['hourlyRate', 'priorUsedLeaveDays', 'carriedOverLeaveDays', 'carryOverApprovedBy'];
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      // Self-registration from the worker portal: always starts as "pending" for HR review.
      allow create: if isHrAdmin() || (
        isSelf(workerId)
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(hrOnlyWorkerFields())
      );
      allow update: if isHrAdmin() || (
        isSelf(workerId)
        && changedOnly([
          'expoPushToken', 'webPushSubscriptions', 'webPushUpdatedAt', 'expectedSalary',
          'lastLogin', 'lastLogout', 'currentLoginTime', 'isOnline',
          'presenceStatus', 'lastActiveAt', 'lastActiveCheckAt', 'missedCheckInAt',
          'currentTaskTitle', 'currentTaskNote'
        ])
      );
      allow delete: if isHrAdmin();
    }

    // ── Attendance (People & HR) ────────────────────────────────────────────
    match /workSessions/{id} {
      allow read: if isSignedIn();
      allow create: if isHrAdmin() || ownsIncoming();
      allow update: if isHrAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if isHrAdmin();
    }

    // ── HR-POL-2026 permission ledger (People & HR) ─────────────────────────
    // id = {uid}_{YYYY-MM-DD}_{late|early}
    match /permissionLedger/{entryId} {
      function idMatches(d) {
        return (d.kind == 'late' && entryId == request.auth.uid + '_' + d.date + '_late')
          || (d.kind == 'early_leave' && entryId == request.auth.uid + '_' + d.date + '_early');
      }

      function validWorkerEntry(d) {
        return d.keys().hasOnly([
            'workerId', 'workerName', 'workerEmail', 'cycleId', 'date', 'kind',
            'clockInHm', 'requiredEndHm', 'actualMinutes', 'chargedMinutes', 'covered',
            'fallbackPenaltyDays', 'uncoveredReason', 'status', 'source', 'createdAt'
          ])
          && d.workerId == request.auth.uid
          && idMatches(d)
          && isCurrentDay(d.date)
          && d.status == 'applied'
          && d.source in ['auto', 'worker']
          && d.covered is bool
          && d.chargedMinutes is number && d.chargedMinutes >= 0 && d.chargedMinutes <= 240
          && (d.covered == true || d.chargedMinutes == 0);
      }

      // HR reversed / re-applied / created it → the worker can't change it any more.
      function hrLocked() {
        return resource.data.get('source', '') == 'admin'
          || 'reversedBy' in resource.data
          || 'reappliedBy' in resource.data;
      }

      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);

      allow create: if isHrAdmin() || (isSignedIn() && validWorkerEntry(request.resource.data));

      allow update: if isHrAdmin() || (
        ownsExisting()
        && !hrLocked()
        && isCurrentDay(resource.data.date)
        && (
          // (a) Late arrival: worker changes their choice (permission ↔ salary deduction), same day.
          (
            resource.data.kind == 'late'
            && resource.data.status == 'applied'
            && changedOnly(['covered', 'chargedMinutes', 'fallbackPenaltyDays', 'uncoveredReason', 'source', 'choiceUpdatedAt'])
            && request.resource.data.source == 'worker'
            && request.resource.data.covered is bool
            && request.resource.data.chargedMinutes is number
            && request.resource.data.chargedMinutes >= 0 && request.resource.data.chargedMinutes <= 240
            && (request.resource.data.covered == true || request.resource.data.chargedMinutes == 0)
          )
          // (b) Early leave: worker came back the same day → entry reversed (quota refunded).
          || (
            resource.data.kind == 'early_leave'
            && changedOnly(['status', 'reversedReason', 'reversedAt'])
            && request.resource.data.status == 'reversed'
            && request.resource.data.reversedReason == 'returned_same_day'
          )
          // (c) Early leave again later the same day → entry rewritten.
          || (
            resource.data.kind == 'early_leave'
            && request.resource.data.date == resource.data.date
            && validWorkerEntry(request.resource.data)
          )
        )
      );

      allow delete: if isHrAdmin();
    }

    // ── Requests, leave & payroll (People & HR) ─────────────────────────────
    match /exceptionRequests/{id} {
      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);
      allow create: if isHrAdmin() || (ownsIncoming() && request.resource.data.status == 'pending');
      allow update, delete: if isHrAdmin();
    }

    match /payrollAdjustments/{id} {
      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);
      allow write: if isHrAdmin();
    }

    match /payrollCycles/{id} {
      allow read, write: if isHrAdmin();
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isHrAdmin();
    }

    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isHrAdmin();
    }

    match /penalties/{id} {
      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);
      allow write: if isHrAdmin();
    }

    // ── Reimbursements (clause 5 — People & HR) ─────────────────────────────
    // Outdoor claims start in "review", purchases in "pre_approval". Workers may only
    // (a) attach image ids right after creating, and (b) upload the stage-2 invoice
    // while the claim is "pending_invoice".
    match /reimbursements/{id} {
      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);
      allow create: if isHrAdmin() || (
        ownsIncoming()
        && request.resource.data.stage in ['pre_approval', 'review']
        && request.resource.data.get('approvedAmount', null) == null
      );
      allow update: if isHrAdmin() || (
        ownsExisting()
        && (
          (
            resource.data.stage in ['pre_approval', 'review']
            && changedOnly(['attachmentIds', 'attachmentKinds', 'imageHashes', 'updatedAt'])
          )
          || (
            resource.data.stage == 'pending_invoice'
            && request.resource.data.stage == 'review'
            && changedOnly([
                 'stage', 'invoiceAmount', 'attachmentIds', 'attachmentKinds',
                 'imageHashes', 'invoiceSubmittedAt', 'updatedAt'
               ])
          )
        )
      );
      allow delete: if isHrAdmin();
    }

    // Compressed image data URLs (≤ ~300 KB each, Firestore doc limit is 1 MiB).
    match /reimbursementAttachments/{id} {
      allow read: if isHrAdmin() || ownsExisting() || (isSignedIn() && resource == null);
      allow create: if isHrAdmin() || (
        ownsIncoming()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 450000
      );
      allow update: if false;
      allow delete: if isHrAdmin();
    }

    // ── Tasks, projects & chat (Work & Clients) ─────────────────────────────
    match /tasks/{id} {
      function isAssignedWorker(d) {
        return (d.get('assignedTo', null) is list && request.auth.uid in d.assignedTo)
          || (d.get('assignedTo', null) is string && request.auth.uid == d.assignedTo)
          || (d.get('assignedWorkerIds', null) is list && request.auth.uid in d.assignedWorkerIds)
          || (d.get('workerId', null) is string && request.auth.uid == d.workerId);
      }

      function isUnassignedTask(d) {
        return (
          !(d.get('assignedTo', null) is list && d.assignedTo.size() > 0)
          && !(d.get('assignedTo', null) is string && d.assignedTo != '' && d.assignedTo != 'unassigned')
        );
      }

      // Workers may move tasks across assigned / in-progress / pending-approval, but only
      // Work/Super admins can mark a task "completed" (unless it was already completed).
      function validWorkerTaskStatus() {
        let nextStatus = request.resource.data.get('status', '');
        let prevStatus = resource.data.get('status', '');
        return nextStatus in ['assigned', 'in-progress', 'pending-approval']
          || nextStatus == prevStatus;
      }

      allow read: if isSignedIn();
      allow create: if isOpsAdmin() || (
        isSignedIn()
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'assigned'
      );
      allow delete: if isOpsAdmin() || (
        isSignedIn()
        && resource.data.get('createdBy', '') == request.auth.uid
      );
      allow update: if isOpsAdmin() || (
        isSignedIn()
        && validWorkerTaskStatus()
        && (
          // (a) Assigned worker starts task, submits/undoes approval, or updates checklist items.
          (
            isAssignedWorker(resource.data)
            && changedOnly(['status', 'startedAt', 'submittedForApprovalAt', 'updatedAt', 'subtasks'])
          )
          // (b) Worker claims an unassigned directive.
          || (
            isUnassignedTask(resource.data)
            && request.resource.data.get('assignedTo', '') == request.auth.uid
            && changedOnly([
                 'assignedTo', 'assignedWorkerName', 'assignedWorkerIds',
                 'status', 'startedAt', 'updatedAt'
               ])
          )
          // (c) Creator or assignee edits task details from TasksPanel.
          || (
            (resource.data.get('createdBy', '') == request.auth.uid || isAssignedWorker(resource.data))
            && changedOnly([
                 'title', 'description', 'department', 'priority', 'status',
                 'assignedTo', 'assignedWorkerName', 'assignedWorkerIds',
                 'startDate', 'dueDate', 'photo', 'subtasks', 'projectId', 'projectName',
                 'startedAt', 'submittedForApprovalAt', 'updatedAt'
               ])
          )
        )
      );

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isOpsAdmin();
      }
    }

    match /projects/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isOpsAdmin();
      allow update: if isOpsAdmin() || (
        isSignedIn()
        && changedOnly(['lastMessageAt', 'lastMessageText', 'lastMessageSender', 'updatedAt'])
      );

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isOpsAdmin();
      }
    }

    match /submissions/{id} {
      allow read, write: if isOpsAdmin();
    }

    match /alerts/{id} {
      allow read: if isSignedIn();
      // Admins can create any alert; workers can only create non-penalty task schedule notifications.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.get('type', '') == 'schedule'
        && request.resource.data.get('isRead', false) == false
        && request.resource.data.get('hasPenalty', false) == false
        && !('penaltyApplied' in request.resource.data)
      );
      allow delete: if isAdmin();
      // Workers can only mark their own alerts as read (cannot tamper with message or penalty fields).
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.get('recipients', null) is list
        && request.auth.uid in resource.data.recipients
        && changedOnly(['isRead', 'readBy'])
      );
    }

    match /chatNotifications/{notifId} {
      allow create: if isSignedIn();
      allow read: if isOpsAdmin()
        || (isSignedIn() && resource.data.get('recipientUid', null) == request.auth.uid);
      allow update: if isOpsAdmin()
        || (
          isSignedIn()
          && resource.data.get('recipientUid', null) == request.auth.uid
          && changedOnly(['isRead'])
        );
      allow delete: if isOpsAdmin();
    }

    match /adminNotifications/{id} {
      allow create: if isSignedIn();
      allow read, update: if isSuperAdmin()
        || (isOpsAdmin() && resource.data.targetRoles is list && 'ops_admin' in resource.data.targetRoles)
        || (isHrAdmin() && resource.data.targetRoles is list && 'hr_admin' in resource.data.targetRoles);
      allow delete: if isSuperAdmin();
    }

    match /activityLog/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if isSuperAdmin();
    }

    match /adminPushSubscriptions/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isSelf(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
